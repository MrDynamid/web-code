NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Postgres — used by Drizzle ORM in server actions.
# The app also checks SUPABASE_DB_URL (auto-set by the Supabase integration) as a fallback.
# DATABASE_URL=postgresql://postgres.your-project:[YOUR-DB-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase Service Role Key — used for server-side storage uploads (bypasses RLS).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Better Auth
BETTER_AUTH_SECRET=generate-a-random-secret-string
BETTER_AUTH_URL=http://localhost:3000

# Razorpay (get from https://dashboard.razorpay.com/app/keys)
# Leave blank to show a "payments not configured" message at checkout instead of crashing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Admin access — comma-separated emails that can access /admin
ADMIN_EMAILS=you@example.com
