# Neon Postgres — Auto-set by Neon integration
# DATABASE_URL is the pooled connection for app queries
# DATABASE_URL_UNPOOLED is the direct connection for schema migrations
DATABASE_URL=postgresql://user:password@host/database
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database

# Vercel Blob Storage — Auto-set by Blob integration
BLOB_READ_WRITE_TOKEN=your-blob-token

# Better Auth — Session signing secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=generate-a-random-secret-string
BETTER_AUTH_URL=http://localhost:3000

# Razorpay (get from https://dashboard.razorpay.com/app/keys)
# Leave blank to show a "payments not configured" message at checkout instead of crashing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Admin access — comma-separated emails that can access /admin
ADMIN_EMAILS=you@example.com
