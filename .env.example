# ─────────────────────────────────────────────
# Maison Lumière — environment variables
# Copy to .env and fill in your own values.
# NEVER commit your real .env to git.
# ─────────────────────────────────────────────

# Database
# Use a Neon, Supabase, Railway or any Postgres connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# Better Auth
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Set to your deployed URL in production (e.g. https://yourdomain.com)
BETTER_AUTH_URL=http://localhost:3000

# Razorpay
# Test keys start with rzp_test_ — live keys with rzp_live_
# Get them at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Admin access
# Comma-separated list of email addresses that can access /admin
ADMIN_EMAILS=you@example.com

# Vercel Blob (image uploads in admin)
# Get from Vercel dashboard → Storage → Blob → .env.local button
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxx
